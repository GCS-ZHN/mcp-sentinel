{
  "name": "mcp-sentinel",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "(cd packages/core && bun run build) && (cd packages/opencode && bun run build)",
    "typecheck": "(cd packages/core && bun run build) && (cd packages/core && bun run typecheck) && (cd packages/opencode && bun run typecheck)",
    "test": "bun test",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"packages/*/tests/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"packages/*/tests/**/*.ts\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ]
  }
}
