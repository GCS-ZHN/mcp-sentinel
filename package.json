{
  "name": "opencode-mcp-sentinel",
  "version": "0.1.0",
  "description": "OpenCode plugin that acts as a sentinel between the AI agent and MCP servers — polling long-running tasks on the agent's behalf so that token-costly status loops never enter the LLM inference path",
  "type": "module",
  "main": "dist/plugin.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/plugin.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bunx tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "bun test",
    "prepare": "husky"
  },
  "keywords": [
    "opencode",
    "plugin",
    "mcp",
    "sentinel",
    "poll",
    "ai",
    "coding-agent"
  ],
  "author": "opencode-mcp-sentinel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tickernelz/opencode-mcp-sentinel.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.3.13",
    "@opencode-ai/sdk": "1.3.13",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "opencode": {
    "type": "plugin",
    "hooks": [
      "tool"
    ]
  },
  "files": [
    "dist",
    "package.json"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ]
  }
}
