{
  "name": "@gcszhn/mcp-sentinel-opencode-plugin",
  "version": "1.4.0",
  "description": "OpenCode plugin that acts as a sentinel between the AI agent and MCP servers — polling long-running tasks on the agent's behalf so that token-costly status loops never enter the LLM inference path",
  "type": "module",
  "main": "dist/plugin.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/plugin.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bunx tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.3.13",
    "@opencode-ai/sdk": "1.3.13",
    "@gcszhn/mcp-sentinel-core": "1.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "opencode": {
    "type": "plugin",
    "hooks": [
      "tool"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GCS-ZHN/mcp-sentinel.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ]
}
