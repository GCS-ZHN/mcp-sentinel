{
  "name": "@gcszhn/mcp-sentinel-cli",
  "version": "1.2.0",
  "description": "Harness-agnostic MCP stdio CLI that acts as a sentinel between any agent and MCP servers — polling long-running tasks on the agent's behalf so that token-costly status loops never enter the LLM inference path",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "mcp-sentinel": "./cli.js"
  },
  "scripts": {
    "build": "rm -rf dist cli.js mcp-server.js scripts && bunx tsc && bun build src/cli.ts --outfile cli.js --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@gcszhn/mcp-sentinel-core": "1.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GCS-ZHN/mcp-sentinel.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "cli.js",
    "schema",
    "package.json",
    "README.md",
    "LICENSE"
  ]
}
